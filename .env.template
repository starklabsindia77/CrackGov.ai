# Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# REDIS CONFIGURATION
# ============================================
# Set to 'true' to disable Redis (recommended for local development without Redis)
DISABLE_REDIS=true

# If you have Redis running, comment out DISABLE_REDIS and set this:
# REDIS_URL=redis://localhost:6379

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/crackgov"

# ============================================
# NEXTAUTH
# ============================================
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# AI PROVIDERS (Optional - for plugin features)
# ============================================
# OpenAI
# OPENAI_API_KEY="sk-..."

# Anthropic Claude
# ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini
# GOOGLE_API_KEY="..."

# ============================================
# EMAIL (Optional - for notifications)
# ============================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# ============================================
# STORAGE (Optional - for file uploads)
# ============================================
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="crackgov-uploads"

# ============================================
# PAYMENT (Optional - for subscriptions)
# ============================================
# RAZORPAY_KEY_ID="..."
# RAZORPAY_KEY_SECRET="..."

# ============================================
# DEVELOPMENT
# ============================================
NODE_ENV="development"
