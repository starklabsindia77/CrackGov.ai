{
    "name": "daily-tasks",
    "version": "1.0.0",
    "displayName": "Daily Tasks & Goals",
    "description": "Manage daily study tasks and track goal completion",
    "author": "CrackGov.ai Team",
    "license": "MIT",
    "icon": "CheckSquare",
    "category": "core",
    "routes": [
        {
            "method": "GET",
            "path": "/api/daily-tasks",
            "handler": "routes/list",
            "auth": true
        },
        {
            "method": "POST",
            "path": "/api/daily-tasks",
            "handler": "routes/create",
            "auth": true
        },
        {
            "method": "PUT",
            "path": "/api/daily-tasks/:id/complete",
            "handler": "routes/complete",
            "auth": true
        },
        {
            "method": "DELETE",
            "path": "/api/daily-tasks/:id",
            "handler": "routes/delete",
            "auth": true
        }
    ],
    "navigation": [
        {
            "label": "Daily Tasks",
            "href": "/app/tasks",
            "icon": "CheckSquare",
            "order": 5
        }
    ],
    "config": {
        "defaults": {
            "autoGenerateTasks": true,
            "maxTasksPerDay": 10,
            "enableReminders": true
        }
    },
    "models": [
        "DailyTask"
    ]
}