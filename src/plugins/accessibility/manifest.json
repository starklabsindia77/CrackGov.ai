{
    "name": "accessibility",
    "version": "1.0.0",
    "displayName": "Accessibility Features",
    "description": "WCAG compliance tools and accessibility enhancements",
    "author": "CrackGov.ai Team",
    "license": "MIT",
    "icon": "Eye",
    "category": "core",
    "routes": [
        {
            "method": "GET",
            "path": "/api/accessibility/preferences",
            "handler": "routes/getPreferences",
            "auth": true
        },
        {
            "method": "PUT",
            "path": "/api/accessibility/preferences",
            "handler": "routes/updatePreferences",
            "auth": true
        }
    ],
    "config": {
        "defaults": {
            "enableHighContrast": false,
            "enableScreenReader": true,
            "fontSize": "medium"
        }
    }
}